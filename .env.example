# Strava build-time sync. Copy to `.env` locally; set the same four in the
# Vercel project settings. Never expose these to the client — the sync runs
# only in `prebuild`, and the site fetches nothing at runtime.
#
# Create the app at https://www.strava.com/settings/api, then do the one-time
# OAuth exchange to get a refresh token with the `activity:read_all` scope.
#
# Missing or invalid values are not fatal: the build falls back to the
# committed src/data/telemetry.json and logs a warning.

STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=
STRAVA_REFRESH_TOKEN=
STRAVA_ATHLETE_ID=5854987
