---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { title, kind, blurb, status, tint, url } = project.data;

// External project links open in a new tab; internal ones (this site) do not.
const isExternal = Boolean(url && /^https?:/.test(url));
const href = url ?? `/projects#${project.id}`;
---

<a
  class="project"
  id={project.id}
  href={href}
  data-tint={tint}
  {...isExternal ? { target: '_blank', rel: 'noopener noreferrer' } : {}}
>
  <div class="project__kind">{kind}</div>
  <h3 class="project__title">{title}</h3>
  <p class="project__blurb">{blurb}</p>
  <div class="project__status">{status}</div>
</a>

<style>
  .project {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px 24px 28px;
    background: var(--panel);
    border: 1px solid var(--rule-card);
    color: var(--text);
    min-height: 210px;
    scroll-margin-top: 90px;
  }

  .project:hover {
    border-color: var(--magenta);
    background: rgba(255, 43, 209, 0.06);
    color: var(--text);
  }

  .project__kind {
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
  }

  .project[data-tint='magenta'] .project__kind {
    color: var(--magenta);
  }

  .project[data-tint='cyan'] .project__kind {
    color: var(--cyan);
  }

  .project[data-tint='green'] .project__kind {
    color: var(--green);
  }

  .project__title {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 22px;
    line-height: 1.2;
    margin: 0;
  }

  .project__blurb {
    font-size: 14.5px;
    line-height: 1.55;
    color: var(--muted-2);
    margin: 0;
    text-wrap: pretty;
  }

  .project__status {
    margin-top: auto;
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--meta-dim);
  }
</style>
